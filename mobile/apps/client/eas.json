{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY": "5ec92e4f-238f-47d0-b57c-51971b948389"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "https://taxi.rulplus.ru/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://taxi.rulplus.ru/ws",
        "EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY": "5ec92e4f-238f-47d0-b57c-51971b948389"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://taxi.rulplus.ru/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://taxi.rulplus.ru/ws",
        "EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY": "5ec92e4f-238f-47d0-b57c-51971b948389"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
