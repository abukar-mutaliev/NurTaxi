#!/bin/sh
# Pre-commit: секреты во всём репозитории, затем линт мобильного трека (M0.2).
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)

if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks"
  gitleaks protect --staged --source "$REPO_ROOT" --config "$REPO_ROOT/.gitleaks.toml" --redact
fi

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^mobile/.*\.(ts|tsx)$' || true)

if [ -z "$CHANGED" ]; then
  exit 0
fi

echo "[pre-commit] mobile: prettier + eslint + tsc"
cd mobile

# Пакетами — иначе на Windows «Слишком длинная командная строка» при большом коммите.
echo "$CHANGED" | sed 's|^mobile/||' | xargs -n 30 npx prettier --check || {
  echo "[pre-commit] Форматирование не соответствует Prettier. Запустите: npm run format"
  exit 1
}

npm run lint --silent
npm run typecheck --silent
