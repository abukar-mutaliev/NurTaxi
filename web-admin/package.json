{
  "name": "web-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
