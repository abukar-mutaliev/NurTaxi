{
  "name": "nurtaxi-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Монорепозиторий мобильных приложений Nur Taxi (клиент и водитель)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "client": "npm run start --workspace @nurtaxi/client",
    "driver": "npm run start --workspace @nurtaxi/driver",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "prepare": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.2",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
