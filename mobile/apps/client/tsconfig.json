{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@nurtaxi/shared-core": ["../../packages/shared-core/index.ts"],
      "@nurtaxi/shared-core/*": ["../../packages/shared-core/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", ".expo/web", "dist", "jest.setup.ts"]
}
