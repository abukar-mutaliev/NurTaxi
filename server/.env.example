# ---------------------------------------------------------------------------
# Nur Taxi backend — пример переменных окружения.
# Скопируйте в .env и при необходимости переопределите значения.
# В production секреты берутся из защищённого хранилища (Vault), не из файла.
# ---------------------------------------------------------------------------

# Окружение и приложение
NODE_ENV=development
APP_NAME=nurtaxi-backend
PORT=3000
API_PREFIX=api/v1

# База данных (PostgreSQL + PostGIS)
# Порт 5433 совпадает с маппингом в infra/docker-compose.yml (во избежание конфликта с 5432).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=nurtaxi
DB_PASSWORD=nurtaxi
DB_DATABASE=nurtaxi
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Автоматический запуск миграций при старте (в dev удобно, в prod — через CI)
DB_RUN_MIGRATIONS=false

# Redis (кэш / гео / сессии)
# Порт 6380 совпадает с маппингом в infra/docker-compose.yml (во избежание конфликта с 6379).
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true

# NATS (брокер событий)
NATS_URL=nats://localhost:4222

# S3-совместимое хранилище (MinIO в dev)
S3_ENDPOINT=http://localhost:9000
# Адрес MinIO для мобильных клиентов (presigned upload/download).
# На реальном устройстве — IP вашего ПК в локальной Wi‑Fi сети (тот же, что для EXPO_PUBLIC_API_URL).
# Эмулятор Android: http://10.0.2.2:9000
S3_PUBLIC_ENDPOINT=http://192.168.1.226:9000
S3_REGION=ru-central-1
S3_ACCESS_KEY=nurtaxi
S3_SECRET_KEY=nurtaxi123
S3_BUCKET=nurtaxi-documents
S3_FORCE_PATH_STYLE=true

# JWT (заготовка под фазу 1)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Управление секретами (Vault) — включается на staging/prod
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=

# Наблюдаемость
LOG_LEVEL=debug
LOG_PRETTY=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nurtaxi-backend
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS: в staging/production обязательный явный список без *
CORS_ORIGINS=http://localhost:5173

# Карты / геопоиск (Фаза 3, Des §4.3)
# MAP_PROVIDER — поиск адресов: stub (локальная база) | yandex (Geosuggest + Geocoder)
MAP_PROVIDER=stub
# MAP_ROUTING_PROVIDER — маршрут A→B: osrm (дороги) | stub (прямая линия)
MAP_ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://localhost:5001
# OSRM_FALLBACK_TO_STUB=true — если OSRM недоступен, вернуться к прямой линии
OSRM_FALLBACK_TO_STUB=true
# OSRM_TIMEOUT_MS=8000
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
# YANDEX_GEOSUGGEST_URL=https://suggest-maps.yandex.ru/v1/suggest
# YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1/
# YANDEX_MAPS_LOCALE=ru_RU
# YANDEX_SEARCH_BBOX=44.0,42.8~45.6,43.7
# YANDEX_MAPS_TIMEOUT_MS=8000
