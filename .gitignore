# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Docker / infra local state
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform.lock.hcl
minio-data/
pg-data/

# Generated native projects. Also ignored under mobile/, but repeated here so
# EAS Build on Windows skips them: eas-cli only applies nested .gitignore
# rules when the path uses forward slashes, and the copy step does not.
mobile/apps/*/android/
mobile/apps/*/ios/
