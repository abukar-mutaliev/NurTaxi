# Окружение приложения водителя (M0.6). Скопируйте в `.env` и подставьте свои значения.
# Файл `.env` в git не коммитится.

# development | staging | production
EXPO_PUBLIC_ENV=development

# Базовый URL API вместе с префиксом версии.
#   Эмулятор Android ..... http://10.0.2.2:3000/api/v1
#   Симулятор iOS ........ http://localhost:3000/api/v1
#   Реальное устройство .. http://<IP-вашего-компьютера>:3000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Необязательно: по умолчанию выводится из EXPO_PUBLIC_API_URL как <origin>/ws
# EXPO_PUBLIC_WS_URL=http://10.0.2.2:3000/ws

# Ключ Google Maps для react-native-maps (Android обязательно, iOS — при использовании Google-провайдера)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Наблюдаемость (M0.9)
EXPO_PUBLIC_SENTRY_DSN=

# Отладка: подробный лог сетевых запросов. Никогда не включать в production.
EXPO_PUBLIC_DEBUG_NETWORK=false
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# EAS (M0.11). Значения выдаются после `eas init`.
EAS_PROJECT_ID=
EAS_OWNER=
EAS_UPDATE_URL=
